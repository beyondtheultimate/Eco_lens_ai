# EcoLens AI - Root Environment Template

PORT=5000
NODE_ENV=development

# Local Vision Option (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Hosted Cloud Vision Option (Google Gemini)
# Set GEMINI_API_KEY in server or Vercel environment variables to enable cloud multimodal vision
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-3.8-flash

# Frontend API URL (Configured in Vercel project settings when connecting to a remote backend)
# VITE_API_URL=https://ecolens-api.onrender.com
