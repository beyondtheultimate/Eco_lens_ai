# EcoLens AI - Environment Configuration

# Server Port & Mode
PORT=5000
NODE_ENV=development

# 1. Local Vision Inference Option (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# 2. Hosted Cloud Vision Inference Option (Vercel / Cloud Deployment)
# When deployed to Vercel, localhost Ollama cannot be reached.
# Provide a Google Gemini API key to enable instant cloud vision inference:
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# 3. Frontend API Base URL (leave blank for local Vite proxy, or set to your deployed backend URL on Render/Railway/Fly.io)
# VITE_API_URL=https://ecolens-api.onrender.com
